USE_SQLITE=false
POSTGRES_DB=login2026
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432
NPM_NETWORK=npm_default
FRONTEND_URL=https://login.psgtech.ac.in
CLIENT_URL=https://login.psgtech.ac.in

# IMPORTANT: Generate strong random secrets. Do NOT use the defaults below.
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/login2026

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=login@psgtech.ac.in
SMTP_PASS=replace_with_app_password
SMTP_FROM="LOGIN 2026 Admin <login@psgtech.ac.in>"

# Admin seed password (will be hashed before storage)
SEED_ADMIN_PASSWORD=replace_with_strong_password
