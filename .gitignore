# ============================================================
# LOGIN 2K26 — .gitignore
# ============================================================

# ──────────────────────────────────────────
# 🔑 Environment & Secrets
# ──────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ──────────────────────────────────────────
# 📦 Dependencies
# ──────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/
jspm_packages/
bower_components/

# ──────────────────────────────────────────
# 🏗️ Build & Dist Outputs
# ──────────────────────────────────────────
dist/
build/
client/dist/
client/build/
server/build/
.next/
.nuxt/
out/
.output/

# ──────────────────────────────────────────
# ⚡ Vite (Client)
# ──────────────────────────────────────────
client/.vite/
*.local

# ──────────────────────────────────────────
# 🧪 Coverage & Testing
# ──────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
/test-results/
/playwright-report/
/playwright/.cache/

# ──────────────────────────────────────────
# 📝 Logs
# ──────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids/
*.pid
*.pid.lock

# ──────────────────────────────────────────
# 🗄️ Database
# ──────────────────────────────────────────
*.sql
*.dump
*.db
*.sqlite
*.sqlite3
.dynamodb/

# ──────────────────────────────────────────
# 📁 Uploads & Static Artefacts
# ──────────────────────────────────────────
server/uploads/
server/public/uploads/
uploads/

# ──────────────────────────────────────────
# 🔧 Tooling & Cache
# ──────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.fusebox/
.serverless/
.grunt/
.lock-wscript
lib-cov/
build/Release/

# ──────────────────────────────────────────
# 📝 TypeScript
# ──────────────────────────────────────────
*.tsbuildinfo
typings/

# ──────────────────────────────────────────
# 📦 Package Manager
# ──────────────────────────────────────────
.npm/
.yarn-integrity
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
*.tgz

# ──────────────────────────────────────────
# 🖥️ OS Generated
# ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# ──────────────────────────────────────────
# 🛠️ IDEs & Editors
# ──────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# ──────────────────────────────────────────
# 🔖 Misc
# ──────────────────────────────────────────
.node_repl_history
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.vuepress/dist
.tern-port

./cred.txt
cred.txt
.cred.text

# ──────────────────────────────────────────
